{
  "name": "celular-pro-api",
  "version": "1.0.0",
  "description": "API REST — CelularPro, tienda de celulares certificados",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "metrics": "npm run test:coverage && npm run metrics:duplicacion && npm run metrics:loc",
    "metrics:duplicacion": "npx --yes jscpd src --min-lines 5 --min-tokens 50 --reporters console",
    "metrics:loc": "find src -name '*.ts' -exec wc -l {} + | tail -1",
    "sonar": "npm run test:coverage && npx --yes sonarqube-scanner",
    "verify": "npm run typecheck && npm run test:coverage && npm run metrics:duplicacion",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node-dev --transpile-only src/infrastructure/database/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
