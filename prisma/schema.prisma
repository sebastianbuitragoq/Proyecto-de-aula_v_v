generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Condition {
  NEW
  CERTIFIED
  USED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  password  String
  role      Role      @default(USER)
  banned    Boolean   @default(false)
  banReason String?
  bannedAt  DateTime?
  orders    Order[]
  favorites Favorite[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id      String  @id
  name    String
  tagline String?
  phones  Phone[]
}

model Phone {
  id            String         @id @default(uuid())
  slug          String         @unique
  name          String
  brand         String
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  price         Int
  compareAt     Int?
  badge         String?
  stock         Int            @default(0)
  // Umbral de reposición: por debajo o en este número se levanta una alerta.
  minStock      Int            @default(5)
  condition     Condition      @default(NEW)
  verified      Boolean        @default(false)
  batteryHealth Int?
  ram           String?
  storage       String?
  camera        String?
  battery       String?
  screen        String?
  chip          String?
  shortDesc     String?
  longDesc      String?
  heroImage     String?
  images        PhoneImage[]
  colors        PhoneColor[]
  features      PhoneFeature[]
  orderItems    OrderItem[]
  alerts        Alert[]
  favorites     Favorite[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([brand])
  @@index([condition])
  @@index([verified])
}

model PhoneImage {
  id       Int    @id @default(autoincrement())
  phoneId  String
  phone    Phone  @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  url      String
  position Int    @default(0)

  @@index([phoneId])
}

model PhoneColor {
  id       Int    @id @default(autoincrement())
  phoneId  String
  phone    Phone  @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  colorId  String
  name     String
  hex      String

  @@unique([phoneId, colorId])
  @@index([phoneId])
}

model PhoneFeature {
  id       Int    @id @default(autoincrement())
  phoneId  String
  phone    Phone  @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  feature  String
  position Int    @default(0)

  @@index([phoneId])
}

model Order {
  id        String      @id @default(uuid())
  orderRef  String      @unique
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  email     String
  name      String
  phone     String
  address   String
  city      String
  dept      String
  subtotal  Int
  shipping  Int         @default(0)
  total     Int
  status    OrderStatus @default(CONFIRMED)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phoneId   String?
  phone     Phone?  @relation(fields: [phoneId], references: [id])
  name      String
  heroImage String?
  price     Int
  qty       Int
  colorId   String?
  colorName String?

  @@index([orderId])
}

/// Alerta de inventario de un celular.
///
/// El unique es (phoneId, type) y no incluye isResolved a propósito: cada
/// celular tiene como mucho una fila por tipo de alerta, que se reabre
/// (isResolved = false) cuando el inventario vuelve a caer y se cierra
/// (isResolved = true) cuando se repone. Si isResolved formara parte de la
/// clave, la segunda vez que se cerrara una alerta del mismo tipo chocaría
/// contra la fila cerrada que ya existe.
model Alert {
  id         String   @id @default(uuid())
  phoneId    String
  phone      Phone    @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  type       String // LOW_STOCK | OUT_OF_STOCK
  message    String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([phoneId, type])
  @@index([phoneId])
  @@index([isResolved])
}

/// Celular que un usuario guardó en su lista de favoritos.
///
/// El unique (userId, phoneId) es lo que hace que la operación sea
/// idempotente: marcar dos veces el mismo celular no crea una segunda fila.
/// Ambas relaciones borran en cascada, así que dar de baja un usuario o
/// retirar un celular del catálogo no deja favoritos huérfanos.
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneId   String
  phone     Phone    @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, phoneId])
  @@index([userId])
}
